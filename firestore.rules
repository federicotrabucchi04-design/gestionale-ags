rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The owner is hard-coded so access can never be lost; other users are listed in config/accesso.
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'federico.trabucchi04@gmail.com'
          || (
            exists(/databases/$(database)/documents/config/accesso)
            && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/accesso).data.emails
          )
        );
    }

    function proprietario() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'federico.trabucchi04@gmail.com';
    }

    function collezioneNota(nome) {
      return nome in [
        'fornitori', 'materiePrime', 'prezziMP', 'articoli', 'listini',
        'costiFissi', 'eventi', 'edizioni', 'movimenti', 'inventario'
      ];
    }

    match /config/{id} {
      allow read: if autorizzato();
      // Only the owner can change who is allowed in; everyone authorised can update impostazioni.
      allow create, update: if autorizzato()
        && id in ['impostazioni', 'accesso']
        && (id != 'accesso' || proprietario());
      allow delete: if proprietario();
    }

    match /{collezione}/{documento} {
      allow read: if autorizzato() && collezioneNota(collezione);
      allow create, update: if autorizzato() && collezioneNota(collezione)
        && (!('id' in request.resource.data) || request.resource.data.id == documento);
      allow delete: if autorizzato() && collezioneNota(collezione);
    }
  }
}
